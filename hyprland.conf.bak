source = ~/.config/hypr/monitors.conf
source = ~/.config/hypr/autostart.conf
source = ~/.config/hypr/aesthetics.conf
source = ~/.config/hypr/windowrules.conf
source = ~/.config/hypr/shortcuts.conf

# Debugging
debug:disable_logs = true
debug:enable_stdout_logs = false


# Environment variables
env = XCURSOR_SIZE,18
env = HYPRCURSOR_SIZE,18
env = QT_QPA_PLATFORMTHEME,qt6ct
env = GTK_THEME,Adwaita:dark
env = PAGER,less
# env = all_proxy,socks5://127.0.0.1:1090
# env = HTTP_PROXY,socks5://127.0.0.1:1090
# env = HTTPS_PROXY,socks5://127.0.0.1:1090

# Keyboard
input {
    kb_layout = us
    kb_variant =
    kb_model =
    kb_options = compose:ralt
    kb_rules =

    follow_mouse = 1

    touchpad {
        disable_while_typing = 0
        natural_scroll = true
        clickfinger_behavior = 1
    }


    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.
}

# Mouse
# See https://wiki.hyprland.org/Configuring/Keywords/#per-device-input-configs for more
device {
	 name = razer-razer-deathadder-essential-1
	 sensitivity = -0.7
	 accel_profile = flat
}

device {
	 name = pixart-microsoft-usb-optical-mouse
	 sensitivity = -0.6
	 accel_profile = flat
}
device {
	 name = telink-trust-deskset-mouse
	 sensitivity = -0.5
	 accel_profile = flat
}

device {
	name = opentabletdriver-virtual-artist-tablet
	output = DP-2
}

plugin {
    split-monitor-workspaces {
        enable_persistent_workspaces = 0
    }
}


